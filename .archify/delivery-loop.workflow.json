  "cards": [
    {
      "dot": "cyan",
      "title": "One loop, sized not skipped",
      "items": [
        "Small runs build, verify, ship; standard adds spec and plan; large sends the spec to a human first",
        "One kebab-case slug names the branch, the commit scope and all three documents"
      ]
    },
    {
      "dot": "rose",
      "title": "Different ground truth on purpose",
      "items": [
        "The verifier judges the running app — never AGENTS.md, the plan's reasoning, or the builder's summary",
        "All three report; the agent that wrote the code has no route to approve it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence, not assertion",
      "items": [
        "The baseline is captured before the first edit, because afterwards it cannot be reconstructed",
        "A surface this machine cannot reach is named in the PR body, never left as a blank cell"
      ]
    }
